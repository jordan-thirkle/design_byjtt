{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byjtt.com/schemas/v0.1/design-decision-record.schema.json",
  "title": "ByJTT Design Decision Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "problem", "evidence", "alternatives", "criteria", "decision", "tradeoffs", "risks", "exceptions", "implementation", "validation", "reviewTriggers"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^BDR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "accepted", "superseded", "retired"]},
    "problem": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^BJT-EV-[0-9]{4}$"}, "uniqueItems": true},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["option", "outcome"], "properties": {"option": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}}}},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "decision": {"type": "string", "minLength": 1},
    "tradeoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "implementation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewTriggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "items": {"type": "string", "pattern": "^BDR-[0-9]{4}$"}, "uniqueItems": true}
  }
}
