{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byjtt.com/schemas/v0.1/design-context-package.schema.json",
  "title": "ByJTT Design Context Package v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "generatedAt", "target", "mode", "sources", "hardConstraints", "creativeTerritory", "unresolvedQuestions", "validationTargets", "integrity"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^bjt-dcp:[a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "target": {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"enum": ["model", "agent", "design-tool", "app-builder", "human"]}, "name": {"type": "string", "minLength": 1}, "adapter": {"type": ["string", "null"]}}},
    "mode": {"enum": ["guided", "professional"]},
    "sources": {"type": "object", "additionalProperties": false, "required": ["evidence", "decisions", "contracts", "patterns", "benchmarks"], "properties": {"evidence": {"$ref": "#/$defs/ids"}, "decisions": {"$ref": "#/$defs/ids"}, "contracts": {"$ref": "#/$defs/ids"}, "patterns": {"$ref": "#/$defs/ids"}, "benchmarks": {"$ref": "#/$defs/ids"}}},
    "hardConstraints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "instruction", "verification"], "properties": {"id": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}}},
    "creativeTerritory": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "opportunity", "boundaries"], "properties": {"id": {"type": "string", "minLength": 1}, "opportunity": {"type": "string", "minLength": 1}, "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "unresolvedQuestions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "question", "blocking", "owner"], "properties": {"id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "owner": {"enum": ["human", "agent", "research"]}}}},
    "validationTargets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^BJT-[A-Z0-9]+-[0-9]{2}$"}, "uniqueItems": true},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["sourceDigest", "compilerVersion"], "properties": {"sourceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "compilerVersion": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
