{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byjtt.com/schemas/v0.1/evidence-record.schema.json",
  "title": "ByJTT Evidence Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "source", "claim", "classification", "strength", "status", "observedAt", "applicability", "limitations", "links"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^BJT-EV-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "locator", "publisher"],
      "properties": {
        "kind": {"enum": ["normative-standard", "peer-reviewed-research", "primary-product-documentation", "byjtt-controlled-benchmark", "byjtt-observation", "community-signal", "vendor-claim"]},
        "locator": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1}
      }
    },
    "claim": {"type": "string", "minLength": 1},
    "classification": {"enum": ["observed", "inferred", "hypothesis"]},
    "strength": {"enum": ["normative", "strong", "moderate", "weak", "unrated"]},
    "status": {"enum": ["candidate", "verified", "superseded", "disputed"]},
    "observedAt": {"type": "string", "format": "date"},
    "verifiedAt": {"type": ["string", "null"], "format": "date"},
    "applicability": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "conflictingEvidence": {"type": "array", "items": {"type": "string", "pattern": "^BJT-EV-[0-9]{4}$"}, "uniqueItems": true},
    "reviewDue": {"type": ["string", "null"], "format": "date"},
    "links": {
      "type": "object", "additionalProperties": false,
      "required": ["decisions", "contracts", "benchmarks", "painSignals"],
      "properties": {
        "decisions": {"type": "array", "items": {"type": "string", "pattern": "^BDR-[0-9]{4}$"}, "uniqueItems": true},
        "contracts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "benchmarks": {"type": "array", "items": {"type": "string", "pattern": "^BJT-[A-Z0-9]+-[0-9]{2}$"}, "uniqueItems": true},
        "painSignals": {"type": "array", "items": {"type": "string", "pattern": "^BJT-PAIN-[0-9]{3}$"}, "uniqueItems": true}
      }
    }
  }
}
