{
  "outputDirectory": "app",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    }
  ]
}
