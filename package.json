{
  "name": "byjtt-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run site:check && npm run foundation:validate && npm run benchmark:validate",
    "build": "npm run site:check && npm run benchmark:check",
    "site:check": "node site/verify.mjs",
    "site:serve": "python3 -m http.server 4175 --directory site",
    "foundation:validate": "node harness/validate-foundation.mjs",
    "benchmark:validate": "node harness/validate-benchmark.mjs",
    "benchmark:export-contexts": "node harness/export-benchmark-contexts.mjs",
    "benchmark:run:init": "node harness/init-benchmark-run.mjs",
    "benchmark:serve": "node harness/server.mjs",
    "benchmark:test": "playwright test",
    "benchmark:candidate:smoke": "node harness/run-candidate-evaluator.mjs",
    "benchmark:candidate:evaluate": "node harness/run-candidate-evaluator.mjs",
    "benchmark:check": "npm run benchmark:validate && npm run benchmark:export-contexts && npm run benchmark:test && npm run benchmark:candidate:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
