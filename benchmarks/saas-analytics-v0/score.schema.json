{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byjtt.com/schemas/benchmark-score-v0.json",
  "title": "ByJTT Design Benchmark Score",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmarkId", "benchmarkVersion", "runId", "workflow", "runDate", "dimensions", "efficiency", "evidence", "uncertainty", "conclusion"],
  "properties": {
    "benchmarkId": {"type": "string", "minLength": 1},
    "benchmarkVersion": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tools"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "versionOrDate"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "versionOrDate": {"type": "string", "minLength": 1}
            }
          }
        },
        "contextNotes": {"type": "string"}
      }
    },
    "runDate": {"type": "string", "format": "date"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementCoverage", "ux", "visualDesign", "distinctiveness", "accessibility", "responsiveQuality", "stateResilience", "designSystemConformance", "engineeringQuality", "performance", "mutationFidelity", "provenance", "productionReadiness"],
      "properties": {
        "requirementCoverage": {"$ref": "#/$defs/dimension15"},
        "ux": {"$ref": "#/$defs/dimension12"},
        "visualDesign": {"$ref": "#/$defs/dimension10"},
        "distinctiveness": {"$ref": "#/$defs/dimension8"},
        "accessibility": {"$ref": "#/$defs/dimension12"},
        "responsiveQuality": {"$ref": "#/$defs/dimension8"},
        "stateResilience": {"$ref": "#/$defs/dimension8"},
        "designSystemConformance": {"$ref": "#/$defs/dimension7"},
        "engineeringQuality": {"$ref": "#/$defs/dimension8"},
        "performance": {"$ref": "#/$defs/dimension4"},
        "mutationFidelity": {"$ref": "#/$defs/dimension3"},
        "provenance": {"$ref": "#/$defs/dimension2"},
        "productionReadiness": {"$ref": "#/$defs/dimension3"}
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeMinutes": {"type": ["number", "null"], "minimum": 0},
        "toolCalls": {"type": ["integer", "null"], "minimum": 0},
        "retries": {"type": ["integer", "null"], "minimum": 0},
        "humanInterventions": {"type": ["integer", "null"], "minimum": 0},
        "knownCost": {"type": ["number", "null"], "minimum": 0},
        "knownCostCurrency": {"type": ["string", "null"]},
        "replacedGeneratedCodePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "unexpectedRegressions": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "pathOrUrl", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "pathOrUrl": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "conclusion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "dimensionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "max", "rationale", "evidenceRefs", "confidence"],
      "properties": {
        "score": {"type": "number", "minimum": 0},
        "max": {"type": "number"},
        "rationale": {"type": "string", "minLength": 1},
        "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "dimension15": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 15}, "max": {"type": "number", "const": 15}}}]},
    "dimension12": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 12}, "max": {"type": "number", "const": 12}}}]},
    "dimension10": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 10}, "max": {"type": "number", "const": 10}}}]},
    "dimension8": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 8}, "max": {"type": "number", "const": 8}}}]},
    "dimension7": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 7}, "max": {"type": "number", "const": 7}}}]},
    "dimension4": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 4}, "max": {"type": "number", "const": 4}}}]},
    "dimension3": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 3}, "max": {"type": "number", "const": 3}}}]},
    "dimension2": {"allOf": [{"$ref": "#/$defs/dimensionBase"}, {"type": "object", "properties": {"score": {"type": "number", "maximum": 2}, "max": {"type": "number", "const": 2}}}]}
  }
}
