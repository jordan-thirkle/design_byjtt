{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.byjtt.com/schemas/benchmark-brief-v0.json",
  "title": "ByJTT Design Benchmark Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "version", "title", "problem", "users", "productGoals", "requiredData", "requiredFlows", "requiredStates", "viewports", "accessibility", "contentStress", "constraints", "antiGoals", "acceptanceCriteria"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "primaryJobs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "primaryJobs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "productGoals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requiredData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headlineMetrics", "trend", "segments", "anomalies", "recentEvents"],
      "properties": {
        "headlineMetrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "trend": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "anomalies": {"type": "boolean"},
        "recentEvents": {"type": "boolean"}
      }
    },
    "requiredFlows": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "requiredStates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 240},
          "height": {"type": "integer", "minimum": 240}
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "requirements"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "contentStress": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "antiGoals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
