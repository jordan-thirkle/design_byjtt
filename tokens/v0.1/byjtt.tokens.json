{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "$type": "color",
    "surface": {"canvas": {"$value": {"colorSpace": "srgb", "components": [0.98, 0.98, 0.97], "alpha": 1}}, "ink": {"$value": {"colorSpace": "srgb", "components": [0.08, 0.09, 0.1], "alpha": 1}}, "accent": {"$value": {"colorSpace": "srgb", "components": [0.08, 0.32, 0.52], "alpha": 1}}},
    "text": {"primary": {"$value": "{color.surface.ink}"}, "onAccent": {"$value": {"colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1}}}
  },
  "dimension": {
    "$type": "dimension",
    "space": {"1": {"$value": {"value": 4, "unit": "px"}}, "2": {"$value": {"value": 8, "unit": "px"}}, "3": {"$value": {"value": 12, "unit": "px"}}, "4": {"$value": {"value": 16, "unit": "px"}}, "6": {"$value": {"value": 24, "unit": "px"}}, "8": {"$value": {"value": 32, "unit": "px"}}},
    "focus": {"width": {"$value": {"value": 3, "unit": "px"}}, "offset": {"$value": {"value": 2, "unit": "px"}}}
  },
  "duration": {"$type": "duration", "motion": {"fast": {"$value": {"value": 120, "unit": "ms"}}, "standard": {"$value": {"value": 200, "unit": "ms"}}}}
}
